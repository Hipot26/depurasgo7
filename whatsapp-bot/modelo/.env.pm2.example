# Bot de WhatsApp. Copiar a whatsapp-bot/.env.pm2 (lo lee ecosystem.config.js al arrancar). Sin valores reales aquí.
API_URL=http://127.0.0.1:3008/api   # API de la plataforma central (en otro servidor: https://<host>/api)
BOT_TOKEN=                          # token del bot hacia /api/wa-bot/* (WHATSAPP_BOT_TOKEN del backend)
NTFY_URL=                           # canal push para avisos operativos (QR pendiente, sesión cerrada); vacío = sin aviso
# BACKFILL_DESDE=2026-01-01         # opcional: fecha desde la que se reprocesa el historial al vincular
